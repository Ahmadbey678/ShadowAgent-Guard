{
  "$schema": "https://json.schemastore.org/sarif-2.1.0.json",
  "version": "2.1.0",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "ShadowAgent Guard",
          "semanticVersion": "0.2.0",
          "informationUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard",
          "rules": [
            {
              "id": "CFG-HIDDEN-UNICODE",
              "name": "CfgHiddenUnicode",
              "shortDescription": {
                "text": "Hidden Unicode in agent config"
              },
              "fullDescription": {
                "text": "Invisible Unicode (tag characters, zero-width, bidi overrides) in an agent instruction file can smuggle instructions humans cannot see."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "agent_config"
                ]
              }
            },
            {
              "id": "CFG-INJECTION",
              "name": "CfgInjection",
              "shortDescription": {
                "text": "Prompt injection in agent config"
              },
              "fullDescription": {
                "text": "Agent instruction text tells the agent to ignore instructions, exfiltrate secrets, disable checks or hide actions."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "agent_config"
                ]
              }
            },
            {
              "id": "CFG-MCP-ALWAYSALLOW",
              "name": "CfgMcpAlwaysallow",
              "shortDescription": {
                "text": "MCP tool always allowed"
              },
              "fullDescription": {
                "text": "An MCP server auto-approves a shell/exec/write-capable tool."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "agent_config"
                ]
              }
            },
            {
              "id": "CFG-MODE-OVERPERMISSIVE",
              "name": "CfgModeOverpermissive",
              "shortDescription": {
                "text": "Over-permissive agent mode"
              },
              "fullDescription": {
                "text": "A custom agent mode combines file edit with command/execute access."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "agent_config"
                ]
              }
            },
            {
              "id": "CFG-SECRET-UNIGNORED",
              "name": "CfgSecretUnignored",
              "shortDescription": {
                "text": "Secret file not ignored"
              },
              "fullDescription": {
                "text": "A secret-looking file is present and not covered by .gitignore/.bobignore."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "agent_config"
                ]
              }
            },
            {
              "id": "DEP-INSTALL-SCRIPT",
              "name": "DepInstallScript",
              "shortDescription": {
                "text": "Install script added or changed"
              },
              "fullDescription": {
                "text": "A package.json preinstall/install/postinstall script was added or changed; it runs automatically on npm install."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "deps"
                ]
              }
            },
            {
              "id": "DEP-NONEXISTENT",
              "name": "DepNonexistent",
              "shortDescription": {
                "text": "Nonexistent dependency"
              },
              "fullDescription": {
                "text": "An added dependency does not exist in its registry (hallucinated or removed package; slopsquatting target)."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "deps"
                ]
              }
            },
            {
              "id": "DEP-TYPOSQUAT",
              "name": "DepTyposquat",
              "shortDescription": {
                "text": "Possible typosquat"
              },
              "fullDescription": {
                "text": "An added dependency name is within edit distance 1-2 of a popular package."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "deps"
                ]
              }
            },
            {
              "id": "TST-DELETED",
              "name": "TstDeleted",
              "shortDescription": {
                "text": "Test file deleted"
              },
              "fullDescription": {
                "text": "A test file present at base was deleted."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "tests"
                ]
              }
            },
            {
              "id": "TST-SKIPPED",
              "name": "TstSkipped",
              "shortDescription": {
                "text": "Test skip marker added"
              },
              "fullDescription": {
                "text": "A skip/todo marker was added to a test."
              },
              "helpUri": "https://github.com/Ahmadbey678/ShadowAgent-Guard#rules",
              "properties": {
                "tags": [
                  "security",
                  "ai-supply-chain",
                  "tests"
                ]
              }
            }
          ]
        }
      },
      "automationDetails": {
        "id": "shadowagent-guard/"
      },
      "properties": {
        "verdict": "BLOCK",
        "grade": "F"
      },
      "results": [
        {
          "ruleId": "CFG-MCP-ALWAYSALLOW",
          "level": "error",
          "message": {
            "text": "[CRITICAL] MCP server 'local-shell' has alwaysAllow on a shell/exec/write tool\nEvidence: \"alwaysAllow\": [..., \"shell_exec\", ...]\nFix: Remove shell/exec/write-capable tools from alwaysAllow so they require explicit per-call approval."
          },
          "properties": {
            "security-severity": "9.5",
            "severity": "critical"
          },
          "locations": [
            {
              "physicalLocation": {
                "artifactLocation": {
                  "uri": ".bob/mcp.json"
                },
                "region": {
                  "startLine": 1
                }
